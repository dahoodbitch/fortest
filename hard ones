"""ЗАДАЧА:
# Дано слово (строка). Вывести YES, если строка читается одинаково слева направо и справа налево, иначе NO."""

s = input().strip()

# ИДЕЯ:
# Развернём строку и сравним с оригиналом.
if s == s[::-1]:
    print("YES")
else:
    print("NO")

"""# ЗАДАЧА:
# Дано целое число n. Вывести YES, если n простое, иначе NO.
# Простое число > 1 и делится только на 1 и на себя."""

n = int(input())

# ИДЕЯ:
# Проверяем делители от 2 до sqrt(n). Если нашли делитель — не простое.
if n <= 1:
    print("NO")
else:
    is_prime = True
    i = 2
    while i * i <= n:
        if n % i == 0:
            is_prime = False
            break
        i += 1

    print("YES" if is_prime else "NO")

""" #ЗАДАЧА:
# Дано целое число n. Найти сумму его цифр.
# Пример: 123 -> 1+2+3 = 6"""

n = input().strip()

# ИДЕЯ:
# Превращаем каждую цифру в int и суммируем.
# Если вдруг ввод может быть отрицательным, уберём минус:
if n.startswith('-'):
    n = n[1:]

s = 0
for ch in n:
    s += int(ch)

print(s)

#второй вариант:
# ЗАДАЧА: та же, но без строк
n = int(input())
n = abs(n)

s = 0
while n > 0:
    s += n % 10
    n //= 10

print(s)

