"""  # ЗАДАЧА:
# Сделать мини-опросник из 5 вопросов.
# На каждый вопрос ответ: число 1..4.
# Если ввод неверный — спрашивать повторно.
# В конце вывести сумму баллов."""

questions = [
    "1) How do you rate Python? (1-4): ",
    "2) How do you rate Linux? (1-4): ",
    "3) How do you rate Git? (1-4): ",
    "4) How do you rate Networking? (1-4): ",
    "5) How do you rate Algorithms? (1-4): ",
]

total = 0

# ИДЕЯ:
# Для каждого вопроса крутим while, пока ответ не станет корректным.
for q in questions:
    while True:
        ans = input(q).strip()

        # проверка: это число?
        if ans.isdigit():
            x = int(ans)
            # проверка диапазона
            if 1 <= x <= 4:
                total += x
                break

        print("Ошибка: введи число от 1 до 4.")

print(total)




