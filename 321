print("*******************************************************")
print("****************** WELCOME TO MAZE BANK ****************")
print("*******************************************************")

balance = 400  

while True:
    print("\nДобро пожаловать!")
    print("1 - мой баланс")
    print("2 - пополнить счет")
    print("3 - снять со счета")
    print("4 - выйти")

    check = int(input("Выберите действие: "))

    if check == 1:
        print(f"Ваш баланс: {balance}")

    elif check == 2:
        b = int(input("На какую сумму желаете пополнить счет? "))
        if b > 0:
            balance += b
            print(f"Счет пополнен. Новый баланс: {balance}")
        else:
            print("Сумма должна быть положительной!")

    elif check == 3:
        b = int(input("Какую сумму желаете снять? "))
        if b > balance:
            print("Недостаточно средств!")
        elif b <= 0:
            print("Сумма должна быть положительной!")
        else:
            balance -= b
            print(f"Операция успешна. Новый баланс: {balance}")

    elif check == 4:
        print("Спасибо за использование Maze Bank. До свидания!")
        break

    else:
        print("Неверный выбор. Попробуйте снова.")
